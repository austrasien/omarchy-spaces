#!/usr/bin/env python3
"""Report Cursor approval waits to the Omarchy Spaces bar.

Two signals, because Cursor has no hook for “blocked on the user”:

- Specific unfocused toasts (`Approve command: …`, `Input needed`, …).
- Foot window titles: `Waiting for confirmation` / `Waiting for you` —
  the first-run “allow tools” card, visible even without a toast.

Do not treat “Cursor is waiting for you” or “Cursor needs your input”
as approval. The first is also sent on `stop` (your turn / follow-up).
The second is sent mid-turn while the agent is still burning tokens and
the window is unfocused — no TUI card, no title change. Both used to
leave a sticky red pulse on a desk where nobody was asking.

A finished turn is “Done • …” or “Agent complete”.

Spaces keeps agent badges in memory. After a shell/plugin reload this
daemon re-pushes live working/waiting claims from last/ and approval
stamps, same idea as spaces-bambu-notify.
"""

import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

import dbus
import dbus.mainloop.glib
import traceback

from dbus.lowlevel import HANDLER_RESULT_HANDLED
from gi.repository import GLib

PLUGIN = "tornikegomareli.spaces"
STATE_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "spaces-agent"
APPROVAL_DIR = STATE_DIR / "approval"
LAST_DIR = STATE_DIR / "last"
PLUGINS_DIR = Path.home() / ".config/omarchy/plugins"
SPACES_DIR = PLUGINS_DIR / "tornikegomareli.spaces"
LIVE_STATES = {"working", "waiting"}
HOOK_STATES = {"working", "waiting", "done", "end", "idle"}
AGENT_CLASSES = {"org.omarchy.agent", "org.omarchy.agent.forge"}
SKIP_COMMS = {"systemd", "init"}

title_waiting_pids = set()
toast_waiting_pids = set()
last_file_seen = {}
shell_pid = 0
spaces_stamp = None
reannounce_at = 0.0
SPECIFIC_WAITING = re.compile(
    r"(?:"
    r"Approve(?: pending action| terminal command| file edit| file deletion| MCP tool| command:| \d+ file edits)?"
    r"|Input needed"
    r"|Autoriser"
    r"|Allow (?:this |the )?(?:agent|command|tool)"
    r")",
    re.I,
)
# Same wording Cursor uses on `stop` (“your turn”), on an unfocused
# working turn (“needs your input”), and on a real first-run allow.
# Title or a specific Approve toast must confirm it is approval.
VAGUE_WAITING = re.compile(
    r"(?:"
    r"Cursor is waiting"
    r"|Cursor needs your input"
    r"|waiting for (?:you|confirmation|your)"
    r"|Waiting for (?:you|confirmation)"
    r")",
    re.I,
)
DONE = re.compile(r"^(?:Done •|Agent complete)")
TITLE_WAITING = re.compile(r"^Waiting for (?:confirmation|you)\b", re.I)


def classify(summary, body):
    for text in (str(summary or "").strip(), str(body or "").strip()):
        if DONE.match(text):
            return "done"
        if SPECIFIC_WAITING.search(text):
            return "waiting"
        if VAGUE_WAITING.search(text):
            return "vague"
    return None


def title_is_waiting(title):
    text = str(title or "")
    head = text.split("|", 1)[0].strip()
    return bool(TITLE_WAITING.match(head) or TITLE_WAITING.match(text))


def should_accept_waiting(kind, *, title_waiting, last_state):
    if last_state == "done" and not title_waiting:
        return False
    if kind == "vague" and not title_waiting:
        return False
    return kind in {"waiting", "vague"}


def process_comm(pid):
    try:
        with open(f"/proc/{pid}/comm", encoding="utf-8", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def parent_pid(pid):
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
            stat = fh.read()
    except OSError:
        return 0
    rest = stat[stat.rfind(")") + 1 :].strip().split()
    if len(rest) < 2:
        return 0
    try:
        return int(rest[1])
    except ValueError:
        return 0


def badge_pid(pid):
    # Foot runs notify-send as a child of the terminal. The agent hook clears
    # cursor-approval-<ancestor>, and that ancestor is foot, not notify-send.
    if process_comm(pid) == "notify-send":
        parent = parent_pid(pid)
        if parent > 1:
            return parent
    return pid


def pid_chain(start):
    chain = []
    pid = int(start)
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        try:
            with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
                stat = fh.read()
        except OSError:
            break
        chain.append(pid)
        rest = stat[stat.rfind(")") + 1 :].strip().split()
        if len(rest) < 2:
            break
        try:
            pid = int(rest[1])
        except ValueError:
            break
    return chain


def mark_waiting(pid):
    if pid <= 1:
        return
    APPROVAL_DIR.mkdir(parents=True, exist_ok=True)
    (APPROVAL_DIR / str(pid)).touch()


def clear_waiting(pid):
    if pid <= 1:
        return
    try:
        (APPROVAL_DIR / str(pid)).unlink()
    except OSError:
        pass
    toast_waiting_pids.discard(pid)
    title_waiting_pids.discard(pid)


def end_approval(pid, chain=None, reason=""):
    if pid <= 1:
        return
    clear_waiting(pid)
    pids = chain or pid_chain(pid)
    if pids:
        report(f"cursor-approval-{pid}", "end", pids)
    if reason:
        print(f"spaces-cursor-notify: end-wait pid={pid} reason={reason}", file=sys.stderr)


def report(session, state, pids):
    if not session or not state or not pids:
        return
    subprocess.Popen(
        [
            "omarchy-shell",
            PLUGIN,
            "agent",
            session,
            state,
            ",".join(str(pid) for pid in pids),
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def pid_alive(pid):
    try:
        pid = int(pid)
        if pid <= 1:
            return False
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as fh:
            stat = fh.read()
    except (OSError, TypeError, ValueError):
        return False
    rest = stat[stat.rfind(")") + 1 :].strip()
    return bool(rest) and rest[0] != "Z"


def shell_pid_now():
    global shell_pid
    if shell_pid and pid_alive(shell_pid):
        return shell_pid
    found = 0
    try:
        for name in os.listdir("/proc"):
            if not name.isdigit():
                continue
            try:
                raw = Path(f"/proc/{name}/cmdline").read_bytes()
            except OSError:
                continue
            if b"quickshell" in raw:
                found = int(name)
                break
    except OSError:
        pass
    shell_pid = found
    return found


def plugins_stamp():
    stamp = 0.0
    paths = [PLUGINS_DIR, SPACES_DIR, SPACES_DIR / "Spaces.qml", SPACES_DIR / "Model.js"]
    try:
        paths.extend(p for p in PLUGINS_DIR.iterdir())
    except OSError:
        pass
    for path in paths:
        try:
            stamp = max(stamp, path.stat().st_mtime)
        except OSError:
            continue
    return (stamp, shell_pid_now())


def parse_pids(csv):
    pids = []
    for chunk in str(csv or "").split(","):
        chunk = chunk.strip()
        if not chunk:
            continue
        try:
            number = int(chunk)
        except ValueError:
            continue
        if number > 1:
            pids.append(number)
    return pids


def parse_last_line(path):
    try:
        line = path.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    parts = line.split(None, 1)
    if len(parts) != 2:
        return None
    state, csv = parts[0], parts[1]
    if state not in HOOK_STATES:
        return None
    pids = parse_pids(csv)
    if not pids:
        return None
    return state, pids


def parse_last(path):
    parsed = parse_last_line(path)
    if not parsed or parsed[0] not in LIVE_STATES:
        return None
    return parsed


def distinctive_pids(pids):
    out = []
    for pid in pids:
        try:
            pid = int(pid)
        except (TypeError, ValueError):
            continue
        if pid <= 1 or process_comm(pid) in SKIP_COMMS:
            continue
        out.append(pid)
    return out


def last_state_for_pids(pids):
    want = set(distinctive_pids(pids))
    if not want or not LAST_DIR.is_dir():
        return None
    best = None
    for path in LAST_DIR.iterdir():
        if not path.is_file():
            continue
        parsed = parse_last_line(path)
        if not parsed:
            continue
        state, file_pids = parsed
        if not want.intersection(distinctive_pids(file_pids)):
            continue
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if best is None or mtime > best[0]:
            best = (mtime, state)
    return None if best is None else best[1]


def reannounce_live():
    working = 0
    waiting = 0
    if LAST_DIR.is_dir():
        for path in LAST_DIR.iterdir():
            if not path.is_file():
                continue
            parsed = parse_last(path)
            if not parsed:
                continue
            state, pids = parsed
            if not pid_alive(pids[0]):
                continue
            report(path.name, state, pids)
            if state == "waiting":
                waiting += 1
            else:
                working += 1
    if APPROVAL_DIR.is_dir():
        for stamp in APPROVAL_DIR.iterdir():
            if not stamp.is_file():
                continue
            try:
                pid = int(stamp.name)
            except ValueError:
                continue
            if not pid_alive(pid):
                continue
            chain = pid_chain(pid)
            if not chain:
                continue
            report(f"cursor-approval-{pid}", "waiting", chain)
            waiting += 1
    print(
        f"spaces-cursor-notify: reannounce working={working} waiting={waiting}",
        file=sys.stderr,
    )


def spaces_needs_reannounce():
    """True once, ~0.4s after Spaces/plugins/shell reloaded, and once at start."""
    global spaces_stamp, reannounce_at
    now = time.monotonic()
    current = plugins_stamp()
    if spaces_stamp is None:
        spaces_stamp = current
        reannounce_at = now + 0.4
        return False
    if current != spaces_stamp:
        spaces_stamp = current
        reannounce_at = now + 0.4
        print("spaces-cursor-notify: spaces reload detected", file=sys.stderr)
        return False
    if reannounce_at and now >= reannounce_at:
        reannounce_at = 0.0
        return True
    return False


def lookup_pid(bus, sender):
    if not sender:
        return 0
    try:
        return int(
            bus.call_blocking(
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "GetConnectionUnixProcessID",
                "s",
                (sender,),
            )
        )
    except dbus.DBusException:
        return 0


def handle_notify(lookup, message):
    if message.get_interface() != "org.freedesktop.Notifications" or message.get_member() != "Notify":
        return
    args = message.get_args_list()
    if len(args) < 5:
        return
    summary, body = str(args[3]), str(args[4])
    state = classify(summary, body)
    if not state:
        return
    pid = 0
    if len(args) > 6 and args[6]:
        try:
            pid = int(args[6].get("sender-pid", 0))
        except (TypeError, ValueError):
            pid = 0
    pid = badge_pid(pid or lookup_pid(lookup, message.get_sender()))
    chain = pid_chain(pid)
    if not chain:
        print(
            f"spaces-cursor-notify: {state} from pid {pid} has no process",
            file=sys.stderr,
        )
        return
    if state == "done":
        end_approval(chain[0], chain, reason="toast-done")
        return
    title_waiting = any(title_is_waiting(title) for wpid, title in hypr_agent_windows() if wpid in chain)
    last_state = last_state_for_pids(chain)
    if not should_accept_waiting(state, title_waiting=title_waiting, last_state=last_state):
        print(
            f"spaces-cursor-notify: ignore {state} pid={chain[0]} "
            f"title_waiting={int(title_waiting)} last={last_state or '-'} "
            f"summary={summary!r} body={body!r}",
            file=sys.stderr,
        )
        return
    report(f"cursor-approval-{chain[0]}", "waiting", chain)
    mark_waiting(chain[0])
    toast_waiting_pids.add(chain[0])
    print(
        f"spaces-cursor-notify: waiting pid={chain[0]} summary={summary!r} body={body!r}",
        file=sys.stderr,
    )


def hypr_agent_windows():
    try:
        clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return []
    if not isinstance(clients, list):
        return []
    out = []
    for client in clients:
        if client.get("class") not in AGENT_CLASSES:
            continue
        try:
            pid = int(client.get("pid") or 0)
        except (TypeError, ValueError):
            pid = 0
        if pid <= 1:
            continue
        out.append((pid, str(client.get("title") or "")))
    return out


def scan_titles():
    live = set()
    for pid, title in hypr_agent_windows():
        live.add(pid)
        waiting = title_is_waiting(title)
        was = pid in title_waiting_pids
        if waiting and not was:
            chain = pid_chain(pid)
            if not chain:
                continue
            title_waiting_pids.add(pid)
            mark_waiting(pid)
            report(f"cursor-approval-{pid}", "waiting", chain)
            print(
                f"spaces-cursor-notify: waiting pid={pid} title={title!r}",
                file=sys.stderr,
            )
        elif (not waiting) and was:
            end_approval(pid, pid_chain(pid), reason=f"title={title!r}")
    gone = (title_waiting_pids | toast_waiting_pids) - live
    for pid in gone:
        end_approval(pid, pid_chain(pid), reason="window-gone")
    return True


def reap_done_approvals():
    if not LAST_DIR.is_dir():
        return
    for path in LAST_DIR.iterdir():
        if not path.is_file():
            continue
        parsed = parse_last_line(path)
        if not parsed:
            continue
        state, pids = parsed
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        prev = last_file_seen.get(path.name)
        last_file_seen[path.name] = (mtime, state)
        if state != "done":
            continue
        if prev and prev == (mtime, state):
            continue
        windows = dict(hypr_agent_windows())
        for pid in distinctive_pids(pids):
            if pid not in windows or title_is_waiting(windows[pid]):
                continue
            end_approval(pid, pid_chain(pid), reason=f"hook-done:{path.name}")


def tick():
    try:
        scan_titles()
        reap_done_approvals()
        if spaces_needs_reannounce():
            reannounce_live()
    except Exception:
        traceback.print_exc()
    return True


def main():
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    lookup = dbus.SessionBus()
    monitor = dbus.SessionBus(private=True)
    dbus.Interface(
        monitor.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus"),
        "org.freedesktop.DBus.Monitoring",
    ).BecomeMonitor(
        ["type='method_call',interface='org.freedesktop.Notifications',member='Notify'"],
        dbus.UInt32(0),
    )

    def on_message(bus, message):
        try:
            handle_notify(lookup, message)
        except Exception:
            traceback.print_exc()
        return HANDLER_RESULT_HANDLED

    monitor.add_message_filter(on_message)
    GLib.timeout_add(400, tick)
    print("spaces-cursor-notify: watching toasts and titles", file=sys.stderr)
    GLib.MainLoop().run()


def self_test():
    assert classify("Cursor", "Cursor is waiting for you") == "vague"
    assert classify("Cursor", "Cursor needs your input") == "vague"
    assert classify("Cursor", "Approve command: echo") == "waiting"
    assert classify("Done • 3s", "") == "done"
    assert should_accept_waiting("vague", title_waiting=False, last_state="done") is False
    assert should_accept_waiting("vague", title_waiting=False, last_state="working") is False
    assert should_accept_waiting("vague", title_waiting=True, last_state="done") is True
    assert should_accept_waiting("waiting", title_waiting=False, last_state="done") is False
    assert should_accept_waiting("waiting", title_waiting=False, last_state="working") is True
    assert title_is_waiting("Waiting for confirmation")
    assert title_is_waiting("Waiting for you | extra")
    assert not title_is_waiting("Shared Workspace Sync")
    print("spaces-cursor-notify: self-test ok")


if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    if "--self-test" in sys.argv:
        self_test()
        raise SystemExit(0)
    sys.exit(main() or 0)
