#!/usr/bin/env bash
# Caps Lock LED for Spaces. One worker holds the flock and follows
# $XDG_RUNTIME_DIR/spaces-caps-led.want:
#   blink  pulse until the want file changes
#   on     stay lit (re-apply: i8042 / Hyprland reset the LED to the
#          real Caps state, which is off because Caps is Compose)
#   off    turn off and exit
# Later on/off/blink calls only write the want file if a worker is live.
set -euo pipefail

CMD=${1:-off}
case $CMD in
  on | off | blink | flash) ;;
  *)
    echo "usage: spaces-caps-blink on|off|blink" >&2
    exit 2
    ;;
esac
[[ $CMD == flash ]] && CMD=blink

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
LOCK="$RUNTIME/spaces-caps-blink.lock"
WANT="$RUNTIME/spaces-caps-led.want"

want_set() { printf '%s\n' "$1" >"$WANT"; }
want_get() {
  if [[ -r $WANT ]]; then
    tr -d '\n' <"$WANT"
  else
    printf '%s' off
  fi
}

if [[ -n ${SPACES_CAPS_LED:-} ]]; then
  device=$SPACES_CAPS_LED
else
  shopt -s nullglob
  leds=(/sys/class/leds/input*::capslock)
  shopt -u nullglob
  ((${#leds[@]} > 0)) || exit 0
  device=$(basename "${leds[0]}")
fi

led() {
  /usr/bin/brightnessctl -c leds -d "$device" -q set "$1" >/dev/null 2>&1 || true
}

want_set "$CMD"

exec 9>"$LOCK"
flock -n 9 || exit 0

cleanup() {
  case $(want_get) in
    on | blink) led 1 ;;
    *) led 0 ;;
  esac
}
trap cleanup EXIT

while true; do
  case $(want_get) in
    blink)
      led 1
      sleep 0.35
      [[ $(want_get) == blink ]] || continue
      led 0
      sleep 0.35
      ;;
    on)
      led 1
      sleep 0.15
      ;;
    *)
      led 0
      break
      ;;
  esac
done
